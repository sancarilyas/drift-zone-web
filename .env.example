# Google AdSense yayıncı kimliği (AdMob'daki ca-app-pub-... değil, web için ca-pub-... olur)
VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# AdSense panelinde oluşturulan görüntülü reklam birimlerinin slot numaraları
VITE_ADSENSE_SLOT_TOP=0000000000
VITE_ADSENSE_SLOT_BOTTOM=0000000000

# H5 Games Ads (ödüllü + geçiş reklamları) onayı alındıysa "on" yapın
VITE_H5_GAMES_ADS=off

# Yayına almadan önce "off" olmalı. "on" iken reklam geliri işlemez, test reklamı gösterilir.
VITE_ADSENSE_TEST=off
